    package_application_p
}

triples {
    Language =isa=> Ingredient;
    Library =isa=> Ingredient;
    Framework =isa=> Ingredient;
    Tool =isa=> Ingredient;
    Ingredient =has=> Model;
    Model =has=> Production;
    Section =groups=> Production;

    NodeJS =iof=> Tool;
    NodeJS_model =iof=> Model;
    NodeJS =has=> NodeJS_model;
    NodeJS_model =has=> NodeJS_sec1, NodeJS_sec2, NodeJS_sec3;

    NodeJS_sec1 =iof => Section [ title = "Goals and subgoals" ];
    NodeJS_sec2 =iof => Section [ title = "Development structure" ];
    NodeJS_sec1 =[ groups =>
        goal_p,
        subgoal_p,
        source_p
    ];
    NodeJS_sec2 =[ groups =>
        project_p,
        project_runtime_p,
        project_package_p,
        runtime_p,
        package_p,
        package_dependency_p,
        package_script_p,
        module_p,
        module_import_p,
        module_export_p,
        dependency_p,
        script_p,
        server_p,
        server_request_p,
        server_response_p,
        request_p,
        response_p,
        stream_p,
        stream_read_p,
        stream_write_p,
        event_p,
        event_listen_p,
        event_emit_p,
        environment_p,
        environment_configure_p,
        test_p
    ];
    NodeJS_sec3 =iof => Section [ title = "Development actions" ];
    NodeJS_sec3 =[ groups =>
        create_project_p,
        initialize_package_p,
        install_dependency_p,
        remove_dependency_p,
        update_dependency_p,
        configure_script_p,
        import_module_p,
        export_module_p,
        create_server_p,
        handle_request_p,
        send_response_p,
        read_stream_p,
        write_stream_p,
        listen_event_p,
        emit_event_p,
        configure_environment_p,
        run_development_script_p,
        run_tests_p,
        inspect_error_p,
        build_application_p,
        package_application_p
    ];

    goal_p =iof => Production[
        condition = "If all subgoals were met" ,
        action = "then the goal is met" ,
        probability = 0.026
    ];
    subgoal_p =iof => Production[
        condition = "If a subgoal is already written" ,
        action = "then the subgoal is met" ,
        probability = 0.027
    ];
    source_p =iof => Production[
        condition = "If new source text must be written" ,
        action = "then the grammar construct becomes a subgoal" ,
        probability = 0.027
    ];
    project_p =iof=> Production[
        condition = "If project is a subgoal" ,
        action = "then the project subgoal is met and project_blocks become subgoals" ,
        probability = 0.027
    ];
    project_runtime_p =iof=> Production[
        condition = "If project_blocks is a subgoal and the block 'runtime' is needed" ,
        action = "then the project_blocks subgoal is met and runtime becomes a subgoal" ,
        probability = 0.027
    ];
    project_package_p =iof=> Production[
        condition = "If project_blocks is a subgoal and the block 'package' is needed" ,
        action = "then the project_blocks subgoal is met and package blocks become subgoals" ,
        probability = 0.027
    ];
    runtime_p =iof=> Production[
        condition = "If runtime is a subgoal" ,
        action = "then the runtime subgoal is met and create_project becomes a subgoal" ,
        probability = 0.027
    ];
    package_dependency_p =iof=> Production[
        condition = "If package is a subgoal and the block 'dependency' is needed" ,
        action = "then the package subgoal is met and dependency becomes a subgoal" ,
        probability = 0.027
    ];
    package_script_p =iof=> Production[
        condition = "If package is a subgoal and the block 'script' is needed" ,
        action = "then the package subgoal is met and script becomes a subgoal" ,
        probability = 0.027
    ];
    module_p =iof=> Production[
        condition = "If module is a subgoal" ,
        action = "then the module subgoal is met and module_blocks become subgoals" ,
        probability = 0.027
    ];
    module_import_p =iof=> Production[
        condition = "If module_blocks is a subgoal and the block 'import' is needed" ,
        action = "then the module_blocks subgoal is met and import_module becomes a subgoal" ,
        probability = 0.027
    ];
    module_export_p =iof=> Production[
        condition = "If module_blocks is a subgoal and the block 'export' is needed" ,
        action = "then the module_blocks subgoal is met and export_module becomes a subgoal" ,
        probability = 0.027
    ];
    dependency_p =iof=> Production[
        condition = "If external functionality is needed" ,
        action = "then the dependency subgoal is met and install_dependency becomes a subgoal" ,
        probability = 0.027
    ];
    script_p =iof=> Production[
        condition = "If a repeatable NodeJS command is needed" ,
        action = "then the script subgoal is met and configure_script becomes a subgoal" ,
        probability = 0.027
    ];
    server_p =iof=> Production[
        condition = "If server is a subgoal" ,
        action = "then the server subgoal is met and server_blocks become subgoals" ,
        probability = 0.027
    ];
    server_request_p =iof=> Production[
        condition = "If server_blocks is a subgoal and the block 'request' is needed" ,
