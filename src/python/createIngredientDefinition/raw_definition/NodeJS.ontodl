    ];
    server_response_p =iof=> Production[
        condition = "If server_blocks is a subgoal and the block 'response' is needed" ,
        action = "then the server_blocks subgoal is met and response becomes a subgoal" ,
        probability = 0.017
    ];
    request_p =iof=> Production[
        condition = "If incoming client data must be processed" ,
        action = "then the request subgoal is met and handle_request becomes a subgoal" ,
        probability = 0.017
    ];
    response_p =iof=> Production[
        condition = "If a client response must be produced" ,
        action = "then the response subgoal is met and send_response becomes a subgoal" ,
        probability = 0.017
    ];
    stream_p =iof=> Production[
        condition = "If stream is a subgoal" ,
        action = "then the stream subgoal is met and stream_blocks become subgoals" ,
        probability = 0.017
    ];
    stream_read_p =iof=> Production[
        condition = "If stream_blocks is a subgoal and the block 'read' is needed" ,
        action = "then the stream_blocks subgoal is met and read_stream becomes a subgoal" ,
