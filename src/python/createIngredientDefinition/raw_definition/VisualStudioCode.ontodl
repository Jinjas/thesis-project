    VisualStudioCode =iof=> Tool;
    VisualStudioCode_model =iof=> Model;
    VisualStudioCode =has=> VisualStudioCode_model;
    VisualStudioCode_model =has=> VisualStudioCode_sec1, VisualStudioCode_sec2, VisualStudioCode_sec3;

    VisualStudioCode_sec1 =iof => Section [ title = "Goals and subgoals" ];
    VisualStudioCode_sec1 =[ groups =>
        goal_p,
        subgoal_p,
        source_p
    ];
    VisualStudioCode_sec2 =iof => Section [ title = "Development workspace" ];
    VisualStudioCode_sec3 =iof => Section [ title = "Development actions" ];
