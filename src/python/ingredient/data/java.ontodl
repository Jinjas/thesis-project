    goal_p =iof => Production[
        condition = "If all subgoals were met" ,
        action = "then the goal is met" ,
        probability = 0.003937007874015748
    ];
    subgoal_p =iof => Production[
        condition = "If a subgoal is already written" ,
        action = "then the subgoal is met" ,
        probability = 0.003937007874015748
    ];
    source_p =iof => Production[
        condition = "If new source text must be written" ,
        action = "then the grammar construct becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    stylesheet_p =iof => Production[
        condition = "If stylesheet is a subgoal" ,
        action = "then the stylesheet subgoal is met and declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    declaration_p =iof => Production[
        condition = "If declaration is a subgoal" ,
        action = "then the declaration subgoal is met and compilation_unit becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    compilation_unit_p =iof => Production[
        condition = "If compilation_unit is a subgoal" ,
        action = "then the compilation_unit subgoal is met and package_declaration, import_declaration and type_declaration become subgoals" ,
        probability = 0.003937007874015748
    ];
    type_declaration_class_declaration_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block 'class_declaration' is needed" ,
        action = "then the type_declaration subgoal is met and class_declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    type_declaration_interface_declaration_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block 'interface_declaration' is needed" ,
        action = "then the type_declaration subgoal is met and interface_declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    type_declaration_enum_declaration_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block 'enum_declaration' is needed" ,
        action = "then the type_declaration subgoal is met and enum_declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    type_declaration_record_declaration_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block 'record_declaration' is needed" ,
        action = "then the type_declaration subgoal is met and record_declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    type_declaration_annotation_type_declaration_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block 'annotation_type_declaration' is needed" ,
        action = "then the type_declaration subgoal is met and annotation_type_declaration becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    type_declaration_block6_p =iof => Production[
        condition = "If type_declaration is a subgoal and the block '';'' is needed" ,
        action = "then the type_declaration subgoal is met and ';' is written" ,
        probability = 0.003937007874015748
    ];
    package_declaration_p =iof => Production[
        condition = "If package_declaration is a subgoal" ,
        action = "then the package_declaration subgoal is met and 'package', ';' is written and annotations and qualified_name become subgoals" ,
        probability = 0.003937007874015748
    ];
    import_declaration_p =iof => Production[
        condition = "If import_declaration is a subgoal" ,
        action = "then the import_declaration subgoal is met and 'import', 'static', '.', '*', ';' is written and qualified_name becomes a subgoal" ,
        probability = 0.003937007874015748
    ];
    qualified_name_p =iof => Production[
        condition = "If qualified_name is a subgoal" ,
        action = "then the qualified_name subgoal is met and ID, '.' and ID are written" ,
        probability = 0.003937007874015748
    ];
    annotations_p =iof => Production[
        condition = "If annotations is a subgoal" ,
        action = "then the annotations subgoal is met and annotation and annotation become subgoals" ,
        probability = 0.003937007874015748
    ];
    annotation_p =iof => Production[
        condition = "If annotation is a subgoal" ,
        action = "then the annotation subgoal is met and '@', '(', ')' is written and qualified_name and annotation_args become subgoals" ,
        probability = 0.003937007874015748
    ];
    annotation_args_p =iof => Production[
        condition = "If annotation_args is a subgoal" ,
        action = "then the annotation_args subgoal is met and ',' is written and annotation_arg and annotation_arg become subgoals" ,
        probability = 0.003937007874015748
    ];
    annotation_arg_p =iof => Production[
